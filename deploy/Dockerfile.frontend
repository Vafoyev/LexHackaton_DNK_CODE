# ============================================================
#  LexGuard AI — Web Frontend Multi-Stage Dockerfile
#  D-10: React 18 + Three.js WebGL 3D + Live Voice Assistant
#  Stage 1: node builder  → npm ci + tsc + vite build
#  Stage 2: nginx:alpine  → static serving with API proxy
# ============================================================

ARG NODE_VERSION=20

# ── Stage 1: Build ───────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS builder

ARG VITE_API_URL=/api/v1
ARG APP_VERSION=1.0.0

WORKDIR /app

# Cache node_modules layer separately
COPY package.json package-lock.json ./
RUN npm ci --frozen-lockfile --prefer-offline

# Copy source & build
COPY . .

# Inject build-time env vars for Vite
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_APP_VERSION=${APP_VERSION}

RUN npm run build

# ── Stage 2: Production (nginx:alpine) ───────────────────────
FROM nginx:1.27-alpine AS production

ARG APP_VERSION

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Custom nginx config: SPA routing + API proxy + security headers
COPY --from=builder /app/../deploy/nginx.frontend.conf /etc/nginx/conf.d/default.conf 2>/dev/null || true

# Inline nginx config (fallback if no custom conf)
RUN if [ ! -f /etc/nginx/conf.d/default.conf ]; then \
    cat > /etc/nginx/conf.d/default.conf << 'EOF'
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers (D-10 XSS / clickjacking protection)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "microphone=(self), camera=()" always;

    # Gzip for 3D/JS bundles
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Cache static assets
    location ~* \.(js|css|png|svg|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Proxy API calls to Go backend
    location /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE support (AI Live Voice stream)
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # Health endpoint
    location /healthz {
        return 200 '{"status":"UP","service":"lexguard-frontend"}';
        add_header Content-Type application/json;
    }

    # SPA fallback — React Router
    location / {
        try_files $uri $uri/ /index.html;
    }
}
EOF
fi

EXPOSE 80

LABEL org.opencontainers.image.title="LexGuard AI Web Frontend" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.description="React 18 + Three.js 3D + Live Voice Assistant (D-10)"

CMD ["nginx", "-g", "daemon off;"]

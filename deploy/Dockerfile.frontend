# ============================================================
#  LexGuard AI — Web Frontend Multi-Stage Dockerfile
#  D-10: React 18 + Three.js WebGL 3D + Live Voice Assistant
#  Stage 1: node builder  → npm ci + tsc + vite build
#  Stage 2: nginx:alpine  → static serving with API proxy
# ============================================================

ARG NODE_VERSION=20

# ── Stage 1: Build ───────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS builder

ARG VITE_API_URL=/api/v1
ARG APP_VERSION=1.0.0

WORKDIR /app

# Cache node_modules layer separately
COPY package.json package-lock.json ./
RUN npm ci --frozen-lockfile --prefer-offline

# Copy source & build
COPY . .

# Inject build-time env vars for Vite
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_APP_VERSION=${APP_VERSION}

RUN npm run build

# ── Stage 2: Production (nginx:alpine) ───────────────────────
FROM nginx:1.27-alpine AS production

ARG APP_VERSION

# Remove default nginx content and default config
RUN rm -rf /usr/share/nginx/html/* && rm -f /etc/nginx/conf.d/default.conf

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Custom nginx config: SPA routing + API proxy + security headers
COPY --from=builder /app/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

LABEL org.opencontainers.image.title="LexGuard AI Web Frontend" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.description="React 18 + Three.js 3D + Live Voice Assistant (D-10)"

CMD ["nginx", "-g", "daemon off;"]

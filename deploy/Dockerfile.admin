# ============================================================
#  LexGuard AI — Admin Portal Multi-Stage Dockerfile
#  D-10: B2B Analytics Portal, Enterprise Dashboard
#  Stage 1: node builder  → static HTML or npm build
#  Stage 2: nginx:alpine  → static serving
# ============================================================

ARG NODE_VERSION=20

# ── Stage 1: Build (handles both plain HTML and npm projects) ─
FROM node:${NODE_VERSION}-alpine AS builder

ARG VITE_API_URL=/api/v1
ARG APP_VERSION=1.0.0

WORKDIR /app

# Check if package.json exists (npm project) or use plain HTML
COPY . .

RUN if [ -f package.json ]; then \
        npm ci --frozen-lockfile --prefer-offline && \
        VITE_API_URL=${VITE_API_URL} npm run build 2>/dev/null || npm run build; \
    fi

# If no dist directory, treat as static HTML
RUN if [ ! -d dist ] && [ ! -d build ]; then \
        mkdir -p dist && \
        if [ -f index.html ]; then cp -r . dist/; \
        else echo '<!DOCTYPE html><html><head><meta charset="UTF-8"><title>LexGuard Admin</title></head><body><h1>LexGuard AI — Admin Portal</h1><p>Building...</p></body></html>' > dist/index.html; fi; \
    fi

# Normalize output directory
RUN if [ -d build ] && [ ! -d dist ]; then mv build dist; fi

# ── Stage 2: Production ───────────────────────────────────────
FROM nginx:1.27-alpine AS production

ARG APP_VERSION

RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /app/dist /usr/share/nginx/html

RUN cat > /etc/nginx/conf.d/default.conf << 'EOF'
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript;

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location /healthz {
        return 200 '{"status":"UP","service":"lexguard-admin"}';
        add_header Content-Type application/json;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
EOF

EXPOSE 80

LABEL org.opencontainers.image.title="LexGuard AI Admin Portal" \
      org.opencontainers.image.version="${APP_VERSION}"

CMD ["nginx", "-g", "daemon off;"]

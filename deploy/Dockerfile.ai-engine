# ============================================================
#  LexGuard AI — AI Engine (Python 3.11+ gRPC + FastAPI)
#  Multi-Stage Dockerfile (Legal Knowledge Graph & SLM)
#  Stage 1: builder (compile requirements)
#  Stage 2: production (slim image with non-root user)
# ============================================================

ARG PYTHON_VERSION=3.11

# ── Stage 1: Build Dependencies ──────────────────────────────
FROM python:${PYTHON_VERSION}-slim AS builder

WORKDIR /build

# Install compilation essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install virtualenv
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip wheel && \
    pip install --no-cache-dir -r requirements.txt

# Compile Protobuf definitions if present
COPY proto ./proto
RUN if [ -f proto/legal_ai.proto ]; then \
        python -m grpc_tools.protoc \
        -I. \
        --python_out=. \
        --grpc_python_out=. \
        proto/legal_ai.proto 2>/dev/null || true; \
    fi

# ── Stage 2: Production Runtime ──────────────────────────────
FROM python:${PYTHON_VERSION}-slim AS production

ARG APP_VERSION=4.0.0

WORKDIR /app

# Install curl for container healthcheck and libpq runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copy virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/app"
ENV PYTHONUNBUFFERED=1

# Copy application source
COPY . .

# Create unprivileged user (appuser)
RUN groupadd -g 10001 appuser && \
    useradd -u 10001 -g appuser -s /bin/bash -m appuser && \
    chown -R appuser:appuser /app

USER appuser:appuser

EXPOSE 8000 50051

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

LABEL org.opencontainers.image.title="LexGuard AI Engine" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.description="Python 3.11+ gRPC & FastAPI Legal Knowledge Graph & SLM"

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# LexGuard AI 3.0 — Environment Variables
# D-10 Directive: Pro Stack Configuration
# ⚠️  PRODUCTION UCHUN BARCHA QIYMATLARNI O'ZGARTIRING!

APP_ENV=development
APP_VERSION=1.0.0

# ── PostgreSQL 16 + pgvector ─────────────────────────────────
POSTGRES_USER=lexguard
POSTGRES_PASSWORD=lexguard_secret_2026
POSTGRES_DB=lexguard
POSTGRES_PORT=5432

# ── Redis 7 ──────────────────────────────────────────────────
REDIS_PASSWORD=redis_lexguard_2026
REDIS_PORT=6379

# ── MinIO (S3-compatible Object Storage) ─────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_lexguard_2026
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=lexguard-documents

# ── Go Backend ───────────────────────────────────────────────
# JWT_SECRET: openssl rand -hex 32 bilan yangi kalit oling!
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32_in_production
AI_PROVIDER=noop
# Productionda demo-session / OneID mock endpointlari default o'chiq (true qilsangiz hamma uchun ochiladi)
ALLOW_DEMO_LOGIN=false
# Vergul bilan ajratilgan ruxsat etilgan originlar, masalan: https://lexguardai.uz
CORS_ORIGINS=
# /metrics uchun Bearer token (bo'sh bo'lsa faqat loopback)
METRICS_TOKEN=
EXTERNAL_AI_ENABLED=false
BACKEND_PORT=8080

# ── AI Engine (Python 3.11+ gRPC + FastAPI) ───────────────────
AI_ENGINE_PORT=8000
AI_ENGINE_GRPC_PORT=50051
AI_ENGINE_GRPC_ADDR=localhost:50051
# Go backend AI engine ga HTTP orqali ulanadi (Docker: http://ai-engine:8000)
AI_ENGINE_URL=http://localhost:8000
# Bo'sh = dev'da "*", production'da CORS yopiq (backend server-to-server chaqiradi)
AI_ENGINE_CORS_ORIGINS=

# Ixtiyoriy LLM/SLM (none | openai_compat). Yoqilganda model faqat tushuntirish/redline ni sayqallaydi,
# graf zanjirida bo'lmagan modda keltirsa javob rad etiladi.
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=lexguard-slm

# ── Web Frontend ─────────────────────────────────────────────
VITE_API_URL=/api/v1
FRONTEND_PORT=3000

# ── Admin Portal ─────────────────────────────────────────────
ADMIN_PORT=4000

#!/usr/bin/env bash
# ==============================================================================
# orchestrator-attach: Tmux sessiyasiga yoki ma'lum oynaga ulanish
# ==============================================================================
set -euo pipefail

SESSION_NAME="lexguard-swarm"
TARGET="${1:-0}"

if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  echo "⚠️  Tmux sessiyasi '$SESSION_NAME' topilmadi!"
  echo "Avval sessiyani ishga tushiring: ./orchestrator/bin/orchestrator-start"
  exit 1
fi

case "$TARGET" in
  0|orchestrator|lead) win=0 ;;
  1|backend|go) win=1 ;;
  2|mobile|flutter) win=2 ;;
  3|front|web) win=3 ;;
  4|admin) win=4 ;;
  5|legal|rag|ai) win=5 ;;
  6|qa|security|test) win=6 ;;
  7|devops|infra|docker) win=7 ;;
  *) win="$TARGET" ;;
esac

tmux select-window -t "$SESSION_NAME:$win"
tmux attach-session -t "$SESSION_NAME"
